{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "streaming plane lifecycle settings",
  "anyOf": [
    {
      "$ref": "#/$defs/section"
    },
    {
      "type": "object",
      "properties": {
        "streams": {
          "anyOf": [
            {
              "$ref": "#/$defs/section"
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "description": "Host model catalogue used to resolve session.model."
        },
        "providers": {
          "description": "Host provider catalogue used to resolve provider protocol."
        }
      },
      "additionalProperties": true,
      "required": [
        "streams"
      ]
    }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "session": {
          "type": "object",
          "properties": {
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "modalities": {
              "enum": [
                [],
                [
                  "audio"
                ],
                [
                  "text"
                ]
              ],
              "default": []
            },
            "instructions": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "voice": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "input_audio_format": {
              "enum": [
                "pcm16",
                "g711_ulaw",
                null
              ]
            },
            "output_audio_format": {
              "enum": [
                "pcm16",
                "g711_ulaw",
                null
              ]
            },
            "turn_detection": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "server_vad"
                    },
                    "threshold": {
                      "type": "number",
                      "default": 0.5
                    },
                    "prefix_padding_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295,
                      "default": 300,
                      "x-busbar-integer-token": "signed"
                    },
                    "silence_duration_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295,
                      "default": 500,
                      "x-busbar-integer-token": "signed"
                    },
                    "create_response": {
                      "type": "boolean",
                      "default": true
                    },
                    "interrupt_response": {
                      "type": "boolean",
                      "default": true
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "semantic_vad"
                    },
                    "eagerness": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "auto"
                      ],
                      "default": "auto"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ]
                }
              ],
              "default": {
                "type": "server_vad",
                "threshold": 0.5,
                "prefix_padding_ms": 300,
                "silence_duration_ms": 500,
                "create_response": true,
                "interrupt_response": true
              }
            },
            "tools": {
              "type": "array",
              "items": true,
              "default": []
            },
            "tool_choice": {
              "description": "Opaque provider tool-choice JSON, retained verbatim."
            },
            "max_output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "x-busbar-integer-token": "unsigned"
                },
                {
                  "enum": [
                    "inf",
                    null
                  ]
                }
              ]
            }
          },
          "additionalProperties": false,
          "default": {
            "turn_detection": {
              "type": "server_vad",
              "threshold": 0.5,
              "prefix_padding_ms": 300,
              "silence_duration_ms": 500,
              "create_response": true,
              "interrupt_response": true
            }
          }
        },
        "session_max_secs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295,
              "x-busbar-integer-token": "unsigned"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_window_tokens": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4294967295,
          "default": 32768,
          "x-busbar-integer-token": "unsigned"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 4096,
          "x-busbar-integer-token": "unsigned"
        },
        "media": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "listen": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "listen"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "The lifecycle additionally requires max_output_tokens < context_window_tokens; JSON Schema cannot compare sibling numeric values."
    }
  },
  "x-busbar-settings-profile": "integer-token-v1"
}
